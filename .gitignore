# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.lighthouseci/

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep real credentials local; commit only the safe template)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# Django backend runtime output
/backend/staticfiles/
/backend/media/
/backend/.venv/
/backend/db.sqlite3
/backend/celerybeat-schedule*
/backend/load_tests/results/
/backend/test_data/generated/
__pycache__/
*.py[cod]
