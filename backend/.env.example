DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SIGNING_KEY=replace-with-a-stable-platform-managed-signing-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://amaris-mathematics-academy.bethuelthipe.chatgpt.site

POSTGRES_DB=amaris_cms
POSTGRES_USER=amaris
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://amaris:replace-with-a-strong-database-password@db:5432/amaris_cms
DATABASE_SSL_REQUIRED=false
DATABASE_CONN_MAX_AGE=600
DATABASE_CONNECT_TIMEOUT=5
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Size these against the container/host memory available in production.
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.5

DJANGO_CACHE_URL=redis://redis_cache:6379/0
DJANGO_PUBLIC_CACHE_URL=redis://redis_cache:6379/1
DJANGO_CACHE_DEFAULT_TIMEOUT=300
DJANGO_CACHE_KEY_PREFIX=amaris
DJANGO_PUBLIC_CACHE_KEY_PREFIX=amaris-public
DJANGO_CACHE_MAX_CONNECTIONS=30
PUBLIC_CONTENT_CACHE_SECONDS=300
SITE_BOOTSTRAP_CACHE_SECONDS=60

# Supabase Auth is the identity authority for protected student APIs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_AUTH_TIMEOUT_SECONDS=4
SUPABASE_AUTH_CACHE_SECONDS=15
ACCEPTANCE_GITHUB_OIDC_ENABLED=false
ACCEPTANCE_GITHUB_AUDIENCE=amaris-staging
ACCEPTANCE_GITHUB_REPOSITORY=BETHUELTHIPE/Amaris-Mathematics-Academy
ACCEPTANCE_GITHUB_ENVIRONMENT=staging
ACCEPTANCE_GITHUB_REF=refs/heads/main

# Configure a domain-authenticated SMTP provider in production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=10
DEFAULT_FROM_EMAIL=Amaris Mathematics Academy <no-reply@example.com>

# Automated contact-enquiry replies. Keep OPENAI_API_KEY only in the platform secret manager.
AI_ENQUIRY_AUTOREPLY_ENABLED=true
OPENAI_API_KEY=
OPENAI_ENQUIRY_MODEL=gpt-5.6-luna
OPENAI_ENQUIRY_TIMEOUT_SECONDS=10\nOPENAI_ASSISTANT_MODEL=gpt-5.6-luna\nOPENAI_ASSISTANT_TIMEOUT_SECONDS=10

PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PUBLIC_SITE_URL=https://amaris-mathematics-academy-live-students.onrender.com
PUBLIC_API_URL=
PAYFAST_RETURN_URL=https://amaris-mathematics-academy.bethuelthipe.chatgpt.site/payments/pending
PAYFAST_CANCEL_URL=https://amaris-mathematics-academy.bethuelthipe.chatgpt.site/payments/cancelled
PAYFAST_NOTIFY_URL=
PAYFAST_VERIFY_TIMEOUT_SECONDS=8
REDIS_CACHE_MAXMEMORY=256mb
REDIS_CACHE_MEMORY_LIMIT=320m
REDIS_CACHE_CPU_LIMIT=0.5

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=2
CELERY_NOTIFICATION_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=500
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=350000
CELERY_BROKER_POOL_LIMIT=10
CELERY_RESULT_EXPIRES_SECONDS=86400
REDIS_BROKER_MAXMEMORY=512mb
REDIS_BROKER_MEMORY_LIMIT=640m
REDIS_BROKER_CPU_LIMIT=0.75
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=900
PAYMENT_WEBHOOK_MAX_AGE_HOURS=168

WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
WEB_MEMORY_LIMIT=1g
WEB_CPU_LIMIT=1.5
CELERY_MEMORY_LIMIT=1g
CELERY_CPU_LIMIT=1.5
CELERY_NOTIFICATION_MEMORY_LIMIT=512m
CELERY_NOTIFICATION_CPU_LIMIT=0.75
CELERY_BEAT_MEMORY_LIMIT=256m
CELERY_BEAT_CPU_LIMIT=0.25
NGINX_MEMORY_LIMIT=256m
NGINX_CPU_LIMIT=0.5

# Reliability objectives: 6-hour RPO, 4-hour RTO.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=5
BACKUP_KEEP_MONTHLY=12
RESTORE_TEST_INTERVAL_SECONDS=604800
RESTIC_REPOSITORY=s3:s3.af-south-1.amazonaws.com/replace-backup-bucket/amaris
RESTIC_PASSWORD=replace-with-a-separate-long-backup-encryption-password
RESTIC_CHECK_SUBSET=1/20
MIGRATION_BACKUP_REQUIRED=false

# The restore-test database is isolated and disposable. Never point it at db.
RESTORE_TEST_POSTGRES_DB=amaris_restore_test
RESTORE_TEST_POSTGRES_USER=restore_tester
RESTORE_TEST_POSTGRES_PASSWORD=replace-with-a-strong-disposable-database-password

# Monitoring remains on the internal monitoring network; it is not public via NGINX.
FLOWER_PORT=5555
FLOWER_URL=http://flower:5555
FLOWER_BASIC_AUTH=replace-admin-name:replace-with-a-long-random-password
PROMETHEUS_RETENTION_TIME=30d
ALERTMANAGER_WEBHOOK_URL=https://example.invalid/replace-with-on-call-webhook
GRAFANA_PORT=3000
GRAFANA_URL=http://grafana:3000
GF_SERVER_ROOT_URL=http://grafana:3000/
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-password
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_SECURITY_COOKIE_SECURE=false
NGINX_PORT=8080

# Local-development storage settings. In production use the platform secret manager
# and the Kubernetes amaris-secrets object described in deploy/kubernetes/README.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=af-south-1
AWS_BACKUP_KMS_KEY_ID=
MEDIA_BACKUP_BUCKET=

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
