# TEMPLATE ONLY. Copy to backend/.env.notifications on the trusted Docker host.
# Never commit the populated file, print it in logs, or share passwords in chat.
# Uses two Docker containers only; no bundled Redis, Postgres or web service.
# Live production migration 0017 MUST be applied before either process starts.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_THE_PRODUCTION_DJANGO_SECRET
DJANGO_ALLOWED_HOSTS=localhost
SUPABASE_PROJECT_REF=epkcuseloinygkakxxdu
SUPABASE_DATABASE_REQUIRED=true
DATABASE_SSL_REQUIRED=true
DATABASE_SCHEMA=public
# Prefer Supabase's production session pooler, not a staging database.
DATABASE_URL=postgresql://PRODUCTION_USER:REPLACE_PASSWORD@PRODUCTION_POOLER_HOST:5432/postgres?sslmode=require

# Render's production Key Value broker is PRIVATE by default.
# Only use its external TLS URL after adding this host's FIXED PUBLIC IP as
# the sole /32 allowlisted address in the Render Key Value Networking section.
# NEVER use 0.0.0.0/0; never enable unauthenticated Redis access.
# If the host lacks a stable fixed public IP, supply a different PRIVATE VPN
# or secure TLS Redis endpoint accessible to both Django web and containers.
CELERY_BROKER_URL=rediss://default:REPLACE_PASSWORD@ALLOWLISTED_TLS_REDIS_HOST:6379/0
CELERY_RESULT_BACKEND=rediss://default:REPLACE_PASSWORD@ALLOWLISTED_TLS_REDIS_HOST:6379/1

# Genuine authenticated outbound SMTP; do not use console/dummy backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=YOUR_SMTP_HOST
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_SMTP_USERNAME
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=10
DEFAULT_FROM_EMAIL=Amaris Mathematics Academy <verified-sender@your-domain.example>
BOOKING_ADMIN_NOTIFICATION_EMAILS=

# Use the same student/admin private storage configuration as Django web if
# notifications require invoice archive or signed PDF attachments.
SUPABASE_S3_REQUIRED=true
SUPABASE_S3_ENDPOINT_URL=https://epkcuseloinygkakxxdu.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ADMIN_BUCKET=amaris-cms-files
SUPABASE_S3_STUDENT_BUCKET=Amaris Mathematics Academy
SUPABASE_S3_ACCESS_KEY_ID=REPLACE_PRIVATE_STORAGE_ACCESS_KEY
SUPABASE_S3_SECRET_ACCESS_KEY=REPLACE_PRIVATE_STORAGE_SECRET_KEY
