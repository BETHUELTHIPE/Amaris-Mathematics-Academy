MONITORING_DOMAIN=monitoring.example.com
MONITORING_USERNAME=amaris-monitor
# Generate with: docker run --rm caddy:2.10.2-alpine caddy hash-password
# Wrap the bcrypt hash in single quotes so Compose preserves dollar signs.
MONITORING_PASSWORD_HASH='$2a$replace-with-generated-bcrypt-hash'
DJANGO_METRICS_URL=https://amaris-production-web.onrender.com/metrics
DJANGO_HEALTH_URL=https://amaris-production-web.onrender.com/health/ready/
PUBLIC_SITE_URL=https://amaris-mathematics-academy-live-students.onrender.com/
PROMETHEUS_RETENTION_TIME=30d
# External connections restricted to the monitoring server's IP (or a VPN).
POSTGRES_METRICS_URI=postgres.example.com:5432/amaris_production_postgres?sslmode=require
REDIS_BROKER_METRICS_ADDR=rediss://broker.example.com:6379
REDIS_CACHE_METRICS_ADDR=rediss://cache.example.com:6379
REDIS_BROKER_METRICS_USER=
REDIS_CACHE_METRICS_USER=
