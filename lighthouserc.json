{
  "ci": {
    "collect": {
      "startServerCommand": "bash scripts/performance/start-lighthouse-server.sh",
      "startServerReadyPattern": "Lighthouse production-like server ready",
      "startServerReadyTimeout": 90000,
      "numberOfRuns": 1,
      "url": [
        "http://127.0.0.1:4180/",
        "http://127.0.0.1:4180/about",
        "http://127.0.0.1:4180/courses",
        "http://127.0.0.1:4180/courses/caps-grade-12-mathematics",
        "http://127.0.0.1:4180/how-it-works",
        "http://127.0.0.1:4180/contact",
        "http://127.0.0.1:4180/pricing",
        "http://127.0.0.1:4180/login",
        "http://127.0.0.1:4180/register",
        "http://127.0.0.1:4180/forgot-password",
        "http://127.0.0.1:4180/privacy",
        "http://127.0.0.1:4180/terms"
      ],
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 1.0}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.9}],
        "categories:seo": ["error", {"minScore": 0.9}],
        "first-contentful-paint": ["error", {"maxNumericValue": 2000}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
        "total-blocking-time": ["error", {"maxNumericValue": 200}],
        "speed-index": ["error", {"maxNumericValue": 3000}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
