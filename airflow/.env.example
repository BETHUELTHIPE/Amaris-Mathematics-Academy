# Copy to airflow/.env on your VPS, then chmod 600 airflow/.env.
# Never commit real values or reuse Django/Supabase credentials.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
AIRFLOW_FERNET_KEY=REPLACE_WITH_VALID_FERNET_KEY
AIRFLOW_API_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
AIRFLOW_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# The Simple Auth Manager is for local evaluation on a private host only.
# For production, install and configure an RBAC-capable authentication manager.
AIRFLOW_AUTH_MANAGER=airflow.api_fastapi.auth.managers.simple.simple_auth_manager.SimpleAuthManager
