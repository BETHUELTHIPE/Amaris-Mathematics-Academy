{
  "ci": {
    "collect": {
      "startServerCommand": "bash scripts/performance/start-lighthouse-server.sh",
      "startServerReadyPattern": "Lighthouse production-like server ready",
      "startServerReadyTimeout": 90000,
      "numberOfRuns": 3,
      "url": [
        "http://127.0.0.1:4180/",
        "http://127.0.0.1:4180/courses",
        "http://127.0.0.1:4180/contact"
      ],
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "provided",
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 1, "aggregationMethod": "median"}],
        "categories:accessibility": ["error", {"minScore": 0.95, "aggregationMethod": "median"}],
        "categories:best-practices": ["error", {"minScore": 0.9, "aggregationMethod": "median"}],
        "categories:seo": ["error", {"minScore": 0.9, "aggregationMethod": "median"}],
        "first-contentful-paint": ["error", {"maxNumericValue": 1000, "aggregationMethod": "median"}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 1200, "aggregationMethod": "median"}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.01, "aggregationMethod": "median"}],
        "total-blocking-time": ["error", {"maxNumericValue": 50, "aggregationMethod": "median"}],
        "speed-index": ["error", {"maxNumericValue": 1000, "aggregationMethod": "median"}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/perfect"
    }
  }
}
