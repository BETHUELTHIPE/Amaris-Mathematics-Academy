# Copy to .env on the monitoring host. Never commit the real .env file.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_COOKIE_SECURE=false

# Use the existing production Celery broker URL only if the broker is reachable
# from the monitoring host over a secure connection.
CELERY_BROKER_URL=rediss://user:password@broker.example.com:6379/0
