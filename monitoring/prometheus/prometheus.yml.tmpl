global:
  scrape_interval: 30s
  evaluation_interval: 30s
scrape_configs:
  - job_name: prometheus
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:10000"]
  - job_name: django
    metrics_path: /metrics
    scrape_timeout: 10s
    static_configs:
      - targets: ["__DJANGO_TARGET__"]
  - job_name: flower
    metrics_path: /metrics
    scrape_timeout: 10s
    static_configs:
      - targets: ["__FLOWER_TARGET__"]
# Intentionally no cAdvisor job until a verified supported self-managed host exists.
