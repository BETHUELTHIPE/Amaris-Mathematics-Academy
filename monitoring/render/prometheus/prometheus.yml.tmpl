global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    environment: production
    platform: render

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: prometheus
    metrics_path: /admin/monitoring/prometheus/metrics
    static_configs:
      - targets: ["127.0.0.1:10000"]

  - job_name: django
    metrics_path: /metrics
    scrape_timeout: 10s
    follow_redirects: false
    # The app's existing SECURE_PROXY_SSL_HEADER expects this on the trusted
    # Render private network; keep its public HTTPS redirect enabled.
    http_headers:
      X-Forwarded-Proto:
        values: [https]
    static_configs:
      - targets: ["__DJANGO_TARGET__"]
        labels:
          service: amaris-production-web

  - job_name: flower
    metrics_path: /admin/monitoring/flower/metrics
    scrape_timeout: 10s
    static_configs:
      - targets: ["__FLOWER_TARGET__"]
        labels:
          service: amaris-monitoring-flower

  - job_name: render-native
    metrics_path: /metrics
    scrape_timeout: 10s
    static_configs:
      - targets: ["__RENDER_METRICS_TARGET__"]
        labels:
          service: render-metrics-exporter
