            "type": "postgres",
            "uid": "amaris-pg-staging"
          },
          "format": "table",
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(sum(revenue_zar),0)::double precision AS value FROM amaris_reporting.payments_daily WHERE $__timeFilter(bucket)"
