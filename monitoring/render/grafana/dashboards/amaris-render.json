{
  "id": null,
  "uid": "amaris-render-native",
  "title": "Amaris Render Monitoring",
  "tags": ["amaris", "render", "production"],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Django metrics scrape",
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "amaris-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"django\"}"}],
      "fieldConfig": {"defaults": {"noValue": "N/A"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Flower scrape",
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "amaris-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"flower\"}"}],
      "fieldConfig": {"defaults": {"noValue": "N/A"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Render metrics exporter",
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "amaris-prometheus"},
      "targets": [{"refId": "A", "expr": "render_metrics_exporter_refresh_success"}],
      "fieldConfig": {"defaults": {"noValue": "N/A"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Backend CPU",
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "amaris-prometheus"},
      "targets": [{"refId": "A", "expr": "render_service_cpu_usage{resource_name=\"amaris-production-web\"}"}],
      "fieldConfig": {"defaults": {"noValue": "N/A"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Render memory usage",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "amaris-prometheus"},
      "targets": [
        {"refId": "A", "expr": "render_service_memory_usage_bytes{resource_name=\"amaris-production-web\"}", "legendFormat": "backend"},
        {"refId": "B", "expr": "render_service_memory_usage_bytes{resource_name=\"amaris-mathematics-academy-live-students\"}", "legendFormat": "student frontend"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "noValue": "N/A"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Render p95 HTTP latency",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "amaris-prometheus"},
      "targets": [
        {"refId": "A", "expr": "render_service_http_latency_p95_seconds{resource_name=\"amaris-production-web\"}", "legendFormat": "backend"},
        {"refId": "B", "expr": "render_service_http_latency_p95_seconds{resource_name=\"amaris-mathematics-academy-live-students\"}", "legendFormat": "student frontend"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "noValue": "N/A"}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Render HTTP request samples",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "amaris-prometheus"},
      "targets": [
        {"refId": "A", "expr": "render_service_http_requests_window{resource_name=\"amaris-production-web\"}", "legendFormat": "backend"},
        {"refId": "B", "expr": "render_service_http_requests_window{resource_name=\"amaris-mathematics-academy-live-students\"}", "legendFormat": "student frontend"}
      ],
      "fieldConfig": {"defaults": {"noValue": "N/A"}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Render CPU usage",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "amaris-prometheus"},
      "targets": [
        {"refId": "A", "expr": "render_service_cpu_usage{resource_name=\"amaris-production-web\"}", "legendFormat": "backend"},
        {"refId": "B", "expr": "render_service_cpu_usage{resource_name=\"amaris-mathematics-academy-live-students\"}", "legendFormat": "student frontend"}
      ],
      "fieldConfig": {"defaults": {"noValue": "N/A"}, "overrides": []}
    }
  ]
}
