      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**cAdvisor: NOT CONFIGURED**\\n\\nRender managed services do not provide the host mounts required to measure their containers via cAdvisor. No replacement or estimated host measurements are displayed."
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Django HTTP response rate by status",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "amaris-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(django_http_responses_total_by_status_total{job=\"django\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "N/A"
        },
        "overrides": []
      }
